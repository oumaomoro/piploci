# Streamlit Cloud Secrets — configure these in your app's Secrets settings
# Dashboard: https://share.streamlit.io → App settings → Secrets

# Your live backend API base URL (Cloudflare tunnel or VPS endpoint)
# Example: https://your-tunnel.trycloudflare.com/api/v1
#          https://api.yourdomain.com/api/v1
API_BASE = "https://YOUR_CLOUDFLARE_TUNNEL_URL/api/v1"

# Admin credentials (must match ADMIN_USER / ADMIN_PASSWORD on your server)
ADMIN_USER = "admin"
ADMIN_PASSWORD = "AdminPass@2026"
